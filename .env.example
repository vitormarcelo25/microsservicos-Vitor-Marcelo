# Copie para .env e ajuste (cp .env.example .env). O arquivo .env nunca deve ir para o GitHub.
# Tudo funciona sem este arquivo: os valores abaixo são os padrões.

# Segredo para assinar os tokens de login (mínimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, o serviço de Usuários cria um segredo aleatório num volume compartilhado só entre os serviços.
JWT_SEGREDO=

# Validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026
